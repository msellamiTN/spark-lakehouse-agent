# Copy to .env and change all credentials before use.
# Keep exposed ports bound to 127.0.0.1 in docker-compose.yml for local-only access.

SPARK_IMAGE=apache/spark:3.5.6-scala2.12-java17-python3-ubuntu
JUPYTER_IMAGE=spark-lakehouse-jupyter:3.5.6
SPARK_MASTER_UI_PORT=8080
SPARK_MASTER_PORT=7077
SPARK_WORKER_1_UI_PORT=8081
SPARK_WORKER_2_UI_PORT=8082
SPARK_WORKER_CORES=2
SPARK_WORKER_MEMORY=3g

JUPYTER_PORT=8888
JUPYTER_TOKEN=change-this-to-a-long-random-token

OLLAMA_IMAGE=ollama/ollama:0.12.6
OLLAMA_PORT=11434
OLLAMA_KEEP_ALIVE=5m
OLLAMA_MODEL=qwen2.5:3b

# MinIO community image replacement: Docker Hub/Quay upstream pulls are no longer reliable.
MINIO_IMAGE=cgr.dev/chainguard/minio:latest
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-this-minio-password-please

# MCP servers (Streamable HTTP; host ports are loopback-only)
MCP_IMAGE=spark-lakehouse-mcp:3.5.6
SPARK_MCP_PORT=8002
SPARK_MCP_MAX_ROWS=100
SPARK_MCP_HARD_MAX_ROWS=500
MINIO_MCP_PORT=8003

# MinIO MCP scope. Create the allowed bucket in MinIO before using its tools.
# Optional dedicated service-account credentials; blank values fall back to MinIO root credentials (local lab only).
MINIO_MCP_ACCESS_KEY=
MINIO_MCP_SECRET_KEY=
MINIO_MCP_ALLOWED_BUCKETS=lakehouse
MINIO_MCP_ALLOW_WRITES=false
MINIO_MCP_WRITE_PREFIXES=agent-outputs/
MINIO_MCP_MAX_READ_BYTES=1048576
MINIO_MCP_MAX_WRITE_BYTES=1048576
