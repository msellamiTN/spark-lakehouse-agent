{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://data2ai.example/schemas/lakehouse-dataset-contract-1.0.0.json",
  "title": "Lakehouse Dataset Contract",
  "description": "Versioned logical and physical contract for a dataset stored in the MinIO lakehouse bucket.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version", "dataset_id", "domain", "name", "owner",
    "description", "source", "target", "primary_key", "partition_by", "fields"
  ],
  "properties": {
    "contract_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "dataset_id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*$" },
    "domain": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
    "name": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
    "owner": { "type": "string", "minLength": 2 },
    "description": { "type": "string", "minLength": 10 },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["zone", "format", "path_template"],
      "properties": {
        "zone": { "const": "raw" },
        "format": { "enum": ["csv", "json", "parquet"] },
        "path_template": { "type": "string", "pattern": "^s3a://lakehouse/raw/[a-z][a-z0-9_]*/[a-z][a-z0-9_]*/" }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["zone", "format", "path_template"],
      "properties": {
        "zone": { "enum": ["bronze", "silver", "gold"] },
        "format": { "const": "parquet" },
        "path_template": { "type": "string", "pattern": "^s3a://lakehouse/(bronze|silver|gold)/[a-z][a-z0-9_]*/[a-z][a-z0-9_]*/" }
      }
    },
    "primary_key": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" }
    },
    "partition_by": {
      "type": "array", "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" }
    },
    "fields": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["name", "type", "nullable", "description"],
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
          "type": { "enum": ["string", "int", "long", "decimal", "double", "boolean", "date", "timestamp"] },
          "nullable": { "type": "boolean" },
          "description": { "type": "string", "minLength": 3 }
        }
      }
    },
    "quality_rules": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["rule_id", "description", "severity"],
        "properties": {
          "rule_id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
          "description": { "type": "string", "minLength": 5 },
          "severity": { "enum": ["error", "warning"] }
        }
      }
    }
  }
}
