# Copy to .env and replace every sample credential before deployment.
# .env is ignored by Git. Never commit tokens, passwords or Tailscale auth keys.

# Custom Spark runtime: Hadoop S3A and its exact AWS SDK dependency are baked in.
SPARK_BASE_IMAGE=apache/spark:3.5.6-scala2.12-java17-python3-ubuntu
SPARK_IMAGE=spark-lakehouse-s3a:3.5.6
HADOOP_VERSION=3.3.4
AWS_SDK_BUNDLE_VERSION=1.12.262
JUPYTER_IMAGE=spark-lakehouse-jupyter:3.5.6
SPARK_MASTER_UI_PORT=8080
SPARK_MASTER_PORT=7077
SPARK_WORKER_1_UI_PORT=8081
SPARK_WORKER_2_UI_PORT=8082
SPARK_WORKER_CORES=2
SPARK_WORKER_MEMORY=3g

JUPYTER_PORT=8888
JUPYTER_TOKEN=replace-with-a-long-random-token

OLLAMA_IMAGE=ollama/ollama:0.12.6
OLLAMA_PORT=11434
OLLAMA_KEEP_ALIVE=5m
OLLAMA_MODEL=qwen2.5:3b

MINIO_IMAGE=cgr.dev/chainguard/minio:latest
MINIO_MC_IMAGE=minio/mc:RELEASE.2025-08-13T08-35-41Z
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=replace-with-a-strong-unique-password

# MCP local loopback listeners; remote students use the Tailscale Serve URLs.
MCP_IMAGE=spark-lakehouse-mcp:3.5.6
SPARK_MCP_PORT=8002
SPARK_MCP_MAX_ROWS=100
SPARK_MCP_HARD_MAX_ROWS=500
MINIO_MCP_PORT=8003
MCP_GATEWAY_LOCAL_PORT=8088

# Tailscale is part of the default Compose deployment.
# Create a reusable auth key tagged with tag:spark-lakehouse-mcp.
# Keep the real key only in this untracked .env file.
TS_AUTHKEY=tskey-auth-REPLACE_WITH_YOUR_TAGGED_KEY
TS_HOSTNAME=spark-lakehouse-agent

# MinIO MCP scope. Service-account credentials are generated by scripts/bootstrap-minio.sh.
# The bootstrap enforces IAM access only to the lakehouse bucket.

MINIO_MCP_ALLOWED_BUCKETS=lakehouse
MINIO_MCP_ALLOW_WRITES=false
MINIO_MCP_WRITE_PREFIXES=agent-outputs/
MINIO_MCP_MAX_READ_BYTES=1048576
MINIO_MCP_MAX_WRITE_BYTES=1048576
