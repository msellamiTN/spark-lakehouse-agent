{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "LakehouseBucketDiscovery",
      "Effect": "Allow",
      "Action": ["s3:GetBucketLocation", "s3:ListBucket"],
      "Resource": "arn:aws:s3:::lakehouse"
    },
    {
      "Sid": "LakehouseObjectRead",
      "Effect": "Allow",
      "Action": ["s3:GetObject"],
      "Resource": "arn:aws:s3:::lakehouse/*"
    }
  ]
}
